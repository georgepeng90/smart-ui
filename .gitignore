# 插件源码纳入 Git：plugin.json、mcp.json、.agents/plugins/、skills/、uv.lock。
# 不按扩展名全局忽略，以保留工具配置、文档和通用测试资源。

# 具体业务项目数据属于工具使用结果，不进入通用工具仓库。
/projects/

# Python 本地环境、字节码和安装元数据
/.venv/
__pycache__/
*.py[cod]
*.egg-info/

# 自动测试缓存
/.pytest_cache/

# 可由脚本重新生成的构建包、演示和验收产物
/build/
/dist/
/artifacts/

# 本机研究资料和 Agent 工作缓存
/.research/
/.serena/
**/.smartui/cache/
**/.smartui/project.lock
**/.smartui/migration-backups/

# Krita 自动备份
*.kra~

# 本地环境配置与运行日志；示例配置允许纳入版本管理
.env
.env.*
!.env.example
*.log

# 操作系统生成的目录元数据
.DS_Store
Thumbs.db
Desktop.ini
